LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

WEB_ORIGIN=http://localhost:5173
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
TOKEN_TTL_SECONDS=600
MAX_PARTICIPANTS=100
RESERVED_ROOMS=false
ALLOWED_ROOMS=
MEETING_MODE=high-reliability
ENABLE_ADVANCED_NOISE_FILTER=false

# Opcional em desenvolvimento (usa .data/questions.json quando vazio); obrigatório em produção.
DATABASE_URL=
QUESTION_STORE_PATH=.data/questions.json

VITE_API_URL=http://localhost:3001
